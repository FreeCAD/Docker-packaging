# Minimum version where pyside6 is available
FROM ubuntu:25.10

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ENV UTC=true
ENV ARC=false

COPY debian.sh /tmp

RUN apt-get update && \
    apt-get upgrade --yes && \
    sh /tmp/debian.sh && \
    mkdir -p /builds

WORKDIR /builds

VOLUME [ "/builds" ]
